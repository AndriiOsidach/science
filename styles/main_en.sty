\ProvidesPackage{mainen}

\RequirePackage{./styles/common}
\RequirePackage[main=english,ukrainian]{babel}

% ==================== HEADINGS ====================
\titleformat{\section}
  {\centering\bfseries\fontsize{16pt}{24pt}\selectfont}
  {CHAPTER~\thesection.}
  {0.5em}
  {\MakeUppercase}
\titlespacing*{\section}{0pt}{20pt}{6pt}

% ==================== TOC (РОЗДІЛ <n>. ……… page) ====================
\titlecontents{section}
  [0pt]
  {\normalsize\bfseries}                 % <-- no \MakeUppercase here
  {CHAPTER~\thecontentslabel.\enspace}
  {}
  {\titlerule*[.5pc]{.}\bfseries\contentspage}
  [\addvspace{-0.25\baselineskip}]
