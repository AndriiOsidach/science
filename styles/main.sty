% Standard Ukrainian DSTU format for access date: (дата звернення: DD.MM.YYYY)
\DeclareFieldFormat{urldate}{\mkbibparens{#1}}
\newbibmacro*{urldate}{%
  \iffieldundef{urlyear}
    {}
    {\printtext[urldate]{%
       \bibstring{urlseen}\addspace%
       \iffieldundef{urlday}{}{\mkdayzeros{\thefield{urlday}}\adddot}%
       \iffieldundef{urlmonth}{}{\mkmonthzeros{\thefield{urlmonth}}\adddot}%
       \thefield{urlyear}}}}

\DefineBibliographyStrings{ukrainian}{%
  urlseen = {дата звернення:},
}
\DefineBibliographyStrings{english}{%
  urlseen = {дата звернення:},
}

% Suppress URL and urldate when DOI is present
\renewbibmacro*{doi+eprint+url+note}{%
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \newunit\newblock
  \iftoggle{bbx:eprint}
    {\usebibmacro{eprint}}
    {}%
  \newunit\newblock
  \iffieldundef{doi}{%
    \usebibmacro{url+urldate+note}%
  }{%
    \printfield{note}%
  }%
}
