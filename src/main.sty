\ProvidesPackage{main}[2025/10/14 NULP core (XeLaTeX, Times New Roman, UA layout)]

% ==================== REQUIREMENTS ====================
\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{main}{This package requires XeLaTeX}{Run with xelatex.}
\fi

% ==================== PACKAGE INCLUDES ====================
\RequirePackage{fontspec}                         % Unicode fonts (TNR)
\RequirePackage[main=ukrainian,english]{babel}    % Languages
\RequirePackage{geometry}                         % Page layout
\RequirePackage{setspace}                         % Line spacing
\RequirePackage{graphicx}                         % Figures
\RequirePackage{hyperref}                         % Links
\RequirePackage{amsmath}                          % Math
\RequirePackage{amssymb,amsfonts}                 % \mathbb, \mathcal, etc.
\RequirePackage{titlesec}                         % Headings
\RequirePackage{titletoc}                         % TOC formatting
\RequirePackage{enumitem}                         % Lists
\RequirePackage{caption}                          % Captions
\RequirePackage{csquotes}                         % Quotes (works with biblatex+babel)
\RequirePackage{indentfirst}                      % Indent first paragraph after headings
\RequirePackage[
  backend=biber,
  style=numeric,
  sorting=nty,
  autolang=other
]{biblatex}

% ==================== GLOBAL CONFIG ====================
% Font: Times New Roman only
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Times New Roman}

% Body: real 14pt, 1.5 spacing, first-line indent 1.27 cm
\makeatletter
\renewcommand\normalsize{\@setfontsize\normalsize{14pt}{21pt}}
\makeatother
\AtBeginDocument{\normalsize}
\onehalfspacing
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}
\emergencystretch=2em % soften occasional overfull lines

% Geometry
\geometry{a4paper,left=30mm,right=17mm,top=15mm,bottom=15mm}

% Hyperref
\hypersetup{hidelinks}

% TOC caption (UA)
\addto\captionsukrainian{\renewcommand{\contentsname}{ЗМІСТ}}

% ==================== HEADINGS ====================
% Use arabic numbers internally; print "РОЗДІЛ <n>." as the section label
\renewcommand\thesection{\arabic{section}}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

% Section: fully centered (each wrapped line), bold 16pt, uppercase title
\titleformat{\section}
  {\centering\bfseries\fontsize{16pt}{24pt}\selectfont}
  {РОЗДІЛ~\thesection.}
  {0.5em}
  {\MakeUppercase}
\titlespacing*{\section}{0pt}{20pt}{6pt}

% Subsection: bold 14pt, indented like main text
\titleformat{\subsection}
  {\bfseries\fontsize{14pt}{21pt}\selectfont}
  {\thesubsection.}{0.5em}{}
\titlespacing*{\subsection}{1.27cm}{6pt}{6pt}

% Subsubsection: bold+italic 14pt, same indent
\titleformat{\subsubsection}
  {\bfseries\itshape\fontsize{14pt}{21pt}\selectfont}
  {\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{1.27cm}{6pt}{0pt}

% ==================== TOC (РОЗДІЛ <n>. ……… page) ====================
\contentsmargin{0pt}

% Sections in TOC: dotted leaders, bold page
\titlecontents{section}
  [0pt]
  {\normalsize\bfseries}                 % <-- no \MakeUppercase here
  {РОЗДІЛ~\thecontentslabel.\enspace}
  {}
  {\titlerule*[.5pc]{.}\bfseries\contentspage}
  [\addvspace{-0.25\baselineskip}]

% Subsections in TOC
\titlecontents{subsection}
  [1.27cm]
  {\normalsize}
  {\thecontentslabel.\enspace}
  {}
  {\titlerule*[.5pc]{.}\contentspage}
  [\addvspace{-0.3\baselineskip}]

% Subsubsections in TOC
\titlecontents{subsubsection}
  [1.27cm]
  {\normalsize}
  {\thecontentslabel.\enspace}
  {}
  {\titlerule*[.5pc]{.}\contentspage}
  [\addvspace{-0.35\baselineskip}]

% ==================== LISTS (per spec) ====================
\setlist{parsep=0pt, itemsep=0pt, partopsep=0pt, topsep=.5\baselineskip}

% Marked_List (bullet)
\setlist[itemize,1]{
  label=\textbullet,
  leftmargin=2.49cm,
  labelindent=0pt,
  labelwidth=0.84cm,
  labelsep=0.38cm,
  align=parleft
}

% Numbered_List
\setlist[enumerate,1]{
  label=\arabic*.,
  leftmargin=2.54cm,
  labelindent=0pt,
  labelwidth=0.33cm,
  labelsep=0.30cm,
  align=parleft
}

% ==================== CAPTIONS ====================
% 14pt body already; figure centered; table raggedleft
\captionsetup[figure]{justification=centering,labelfont=bf,textfont={bf,it}}
\captionsetup[table]{justification=raggedleft,labelfont=bf,textfont=bf}

% ==================== BIBLIOGRAPHY ====================
\setlength{\bibhang}{0.75cm}
\setlength{\biblabelsep}{0.5cm}

% ==================== HELPERS ====================
\newenvironment{uaabstract}{%
  \section*{АНОТАЦІЯ}\addcontentsline{toc}{section}{АНОТАЦІЯ}%
}{\par}

\newenvironment{enabstract}{%
  \begin{otherlanguage}{english}%
  \section*{ABSTRACT}\addcontentsline{toc}{section}{ABSTRACT}%
}{\par\end{otherlanguage}}
